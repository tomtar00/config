{
    "agent_buffer_font_family": "Departure Mono",
    "ui_font_family": "Departure Mono",
    "terminal": {
        "font_family": "Monocraft"
    },
    "restore_on_startup": "launchpad",
    "diff_view_style": "unified",
    "cli_default_open_behavior": "new_window",
    "buffer_font_family": "Departure Mono",
    "disable_ai": true,
    "outline_panel": {
        "dock": "right",
    },
    "collaboration_panel": {
        "dock": "right",
    },
    "git_panel": {
        "dock": "right",
    },
    "agent_servers": {
        "opencode": {
            "type": "registry",
        },
    },
    "context_servers": {},
    "languages": {
        "Lua": {
            "enable_language_server": false,
            "format_on_save": "off",
            "auto_indent_on_paste": false,
            "auto_indent": "none",
        },
    },
    "buffer_line_height": "standard",
    "git": {
        "inline_blame": {
            "enabled": false,
        },
    },
    "sticky_scroll": {
        "enabled": false,
    },
    "edit_predictions": {
        "mode": "subtle",
        "provider": "zed",
    },
    "show_whitespaces": "none",
    "show_edit_predictions": false,
    "tab_size": 4,
    "project_panel": {
        "sticky_scroll": false,
        "dock": "left",
        "auto_fold_dirs": false,
    },
    "confirm_quit": true,
    "vertical_scroll_margin": 15.0,
    "minimap": {
        "show": "never",
    },
    "cursor_shape": "block",
    "tab_bar": {
        "show_tab_bar_buttons": false,
    },
    "base_keymap": "VSCode",
    "icon_theme": {
        "mode": "light",
        "light": "Material Icon Theme",
        "dark": "Material Icon Theme"
    },
    "agent": {
        "dock": "right",
        "profiles": {
            "agent": {
                "default_model": {
                    "provider": "ollama",
                    "model": "minimax-m2.7:cloud",
                    "enable_thinking": true,
                },
                "name": "Agent",
                "tools": {
                    "copy_path": true,
                    "create_directory": true,
                    "delete_path": true,
                    "diagnostics": true,
                    "edit_file": true,
                    "fetch": true,
                    "find_path": true,
                    "grep": true,
                    "list_directory": true,
                    "move_path": true,
                    "now": true,
                    "open": true,
                    "read_file": true,
                    "restore_file_from_disk": true,
                    "save_file": true,
                    "spawn_agent": true,
                    "update_plan": true,
                    "terminal": true,
                },
                "enable_all_context_servers": false,
                "context_servers": {},
            },
        },
        "default_model": {
            "provider": "ollama",
            "model": "minimax-m2.7:cloud",
            "enable_thinking": true,
        },
        "favorite_models": [],
        "model_parameters": [],
    },
    "theme": {
        "mode": "dark",
        "light": "Dayfox - blurred",
        "dark": "Yukinord",
    },
    "vim_mode": false,
    "ui_font_size": 16,
    "buffer_font_size": 18.0,
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },
}
